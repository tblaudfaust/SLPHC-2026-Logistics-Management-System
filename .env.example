# --- Database ---
POSTGRES_USER=slphc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=slphc_logistics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://slphc:change-me@postgres:5432/slphc_logistics

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- App ---
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
API_V1_PREFIX=/api
QR_CODE_BASE_URL=http://localhost:5173

# --- Bootstrap admin (used by seed.py, change immediately after first login) ---
BOOTSTRAP_ADMIN_EMAIL=admin@statistics.gov.sl
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# --- Email notifications ---
# Leave SMTP_HOST unset to disable email sending (notifications still log to
# the database as SKIPPED, nothing crashes or blocks).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SLPHC 2026 Logistics
IMAP_HOST=
IMAP_PORT=993

# --- SMS notifications (AppHiveSL, api.sierrahive.com) ---
# Leave SMS_CLIENT_ID unset to disable SMS sending (notifications still log
# to the database as SKIPPED, nothing crashes or blocks).
SMS_API_BASE_URL=https://api.sierrahive.com
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=
SMS_TOKEN=
SMS_SENDER_ID=STATS SL
# AppHiveSL portal (human) login — not used by the API itself, kept only for
# reference.
SMS_PORTAL_USERNAME=
SMS_PORTAL_PASSWORD=

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=slphc-documents
S3_REGION=us-east-1

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
